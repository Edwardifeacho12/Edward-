<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Edmed — Complete Medical Research OS</title>
<link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@300;400;500&family=Orbitron:wght@400;500;700;900&family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#040b12;--bg2:#060f1a;--bg3:#0a1623;--surf:#0e1e2e;--surf2:#122438;
  --bd:#182d42;--bd2:#1f3d58;
  --tx:#cce4f6;--tx2:#5d8aaa;--tx3:#2a4d68;
  --a:#00f0c0;--a2:#00c49a;--ad:rgba(0,240,192,.08);--ag:rgba(0,240,192,.25);
  --bl:#3a9fff;--bld:rgba(58,159,255,.08);--blg:rgba(58,159,255,.22);
  --am:#ffbe40;--amd:rgba(255,190,64,.08);
  --rd:#ff4d4d;--rdd:rgba(255,77,77,.08);
  --pu:#c07aff;--pud:rgba(192,122,255,.08);
  --pk:#ff6ec7;--pkd:rgba(255,110,199,.08);
  --cy:#22e0f0;--cyd:rgba(34,224,240,.08);
  --gn:#39d353;--gnd:rgba(57,211,83,.08);
  --r:9px;--sh:0 8px 40px rgba(0,0,0,.6);
}
*{box-sizing:border-box;margin:0;padding:0}
html,body{height:100%;overflow:hidden}
body{font-family:'Outfit',sans-serif;background:var(--bg);color:var(--tx);display:flex}

/* ─ SIDEBAR ─ */
.sb{width:260px;height:100vh;background:var(--bg2);border-right:1px solid var(--bd);display:flex;flex-direction:column;flex-shrink:0;overflow-y:auto;position:relative}
.sb::-webkit-scrollbar{width:3px}.sb::-webkit-scrollbar-thumb{background:var(--bd2)}
.logo-a{padding:20px 18px 16px;border-bottom:1px solid var(--bd);flex-shrink:0}
.logo-r{display:flex;align-items:center;gap:10px}
.logo-i{width:36px;height:36px;background:linear-gradient(135deg,var(--a),var(--bl));border-radius:10px;display:flex;align-items:center;justify-content:center;font-family:'Orbitron',sans-serif;font-size:12px;font-weight:700;color:#020c14;box-shadow:0 0 18px var(--ag);flex-shrink:0}
.logo-n{font-family:'Orbitron',sans-serif;font-size:18px;font-weight:700;letter-spacing:1px;color:var(--a)}
.logo-s{font-family:'DM Mono',monospace;font-size:8.5px;color:var(--tx3);letter-spacing:2px;text-transform:uppercase;margin-top:3px}
.acct{margin:12px 14px 6px;padding:10px 13px;background:linear-gradient(135deg,rgba(0,240,192,.06),rgba(58,159,255,.04));border:1px solid rgba(0,240,192,.15);border-radius:9px}
.acct-lbl{font-family:'DM Mono',monospace;font-size:8px;letter-spacing:1.5px;text-transform:uppercase;color:var(--a);margin-bottom:5px}
.acct-name{font-size:11.5px;font-weight:600;color:var(--tx);margin-bottom:2px}
.acct-bank{font-family:'DM Mono',monospace;font-size:9.5px;color:var(--bl);margin-bottom:5px}
.acct-row{display:flex;align-items:center;justify-content:space-between}
.acct-num{font-family:'DM Mono',monospace;font-size:13px;font-weight:500;color:var(--a);letter-spacing:1.5px}
.cp-btn{background:var(--ad);border:1px solid rgba(0,240,192,.18);border-radius:5px;color:var(--a);font-family:'DM Mono',monospace;font-size:8px;padding:3px 7px;cursor:pointer;transition:all .14s}
.cp-btn:hover{background:var(--a);color:#020c14}
.study-p{margin:5px 14px 10px;padding:9px 12px;background:rgba(58,159,255,.05);border:1px solid rgba(58,159,255,.14);border-radius:8px}
.sp-top{display:flex;align-items:center;justify-content:space-between;margin-bottom:3px}
.sp-lbl{font-family:'DM Mono',monospace;font-size:8px;letter-spacing:1.5px;text-transform:uppercase;color:var(--bl)}
.dlive{width:7px;height:7px;border-radius:50%;background:var(--a);animation:pg 2s infinite}
@keyframes pg{0%,100%{box-shadow:0 0 0 0 rgba(0,240,192,.5)}50%{box-shadow:0 0 0 5px rgba(0,240,192,0)}}
.sp-name{font-size:11.5px;font-weight:500}
.sp-ph{font-family:'DM Mono',monospace;font-size:9.5px;color:var(--bl);margin-top:2px}
nav{padding:5px 0;flex:1;overflow-y:auto}
nav::-webkit-scrollbar{width:2px}
.nl{font-family:'DM Mono',monospace;font-size:8px;letter-spacing:1.5px;text-transform:uppercase;color:var(--tx3);padding:11px 18px 5px}
.ni{display:flex;align-items:center;gap:9px;padding:8px 18px;font-size:12.5px;color:var(--tx2);cursor:pointer;border-left:2px solid transparent;transition:all .12s;user-select:none;position:relative}
.ni:hover{background:rgba(255,255,255,.025);color:var(--tx)}
.ni.on{background:var(--ad);border-left-color:var(--a);color:var(--a);font-weight:500}
.ni.on.ai-ni{background:var(--bld);border-left-color:var(--bl);color:var(--bl)}
.ni.on.sp-ni{background:var(--pud);border-left-color:var(--pu);color:var(--pu)}
.ni.on.sf-ni{background:var(--rdd);border-left-color:var(--rd);color:var(--rd)}
.ni-ic{font-size:13px;width:18px;text-align:center;flex-shrink:0}
.nbadge{margin-left:auto;font-family:'DM Mono',monospace;font-size:8.5px;padding:2px 6px;border-radius:20px}
.nb-r{background:var(--rd);color:#fff}.nb-g{background:var(--a);color:#020c14}.nb-b{background:var(--bl);color:#020c14}
.sb-foot{padding:12px 14px;border-top:1px solid var(--bd);flex-shrink:0}
.usr-r{display:flex;align-items:center;gap:9px}
.av{width:32px;height:32px;border-radius:50%;background:linear-gradient(135deg,var(--a),var(--bl));display:flex;align-items:center;justify-content:center;font-family:'Orbitron',sans-serif;font-size:10px;font-weight:700;color:#020c14;flex-shrink:0}
.u-name{font-size:12px;font-weight:500}
.u-role{font-family:'DM Mono',monospace;font-size:8.5px;color:var(--tx3);letter-spacing:.7px}

/* ─ MAIN ─ */
.main{flex:1;display:flex;flex-direction:column;overflow:hidden}
.topbar{background:var(--bg2);border-bottom:1px solid var(--bd);padding:11px 24px;display:flex;align-items:center;gap:11px;flex-shrink:0}
.tb-title{font-family:'Orbitron',sans-serif;font-size:14px;font-weight:600;flex:1;letter-spacing:.5px}
.tb-r{display:flex;align-items:center;gap:8px}
.tb-clock{font-family:'DM Mono',monospace;font-size:10.5px;color:var(--tx3)}
.btn{display:inline-flex;align-items:center;gap:5px;padding:6px 13px;border-radius:7px;font-family:'Outfit',sans-serif;font-size:12px;font-weight:500;cursor:pointer;border:none;transition:all .13s;white-space:nowrap}
.bp{background:var(--a);color:#020c14}.bp:hover{background:var(--a2)}
.bb{background:var(--bl);color:#020c14}.bb:hover{filter:brightness(1.12)}
.bg{background:var(--surf);color:var(--tx2);border:1px solid var(--bd)}.bg:hover{color:var(--tx);background:var(--surf2)}
.br{background:var(--rdd);color:var(--rd);border:1px solid rgba(255,77,77,.2)}.br:hover{background:var(--rd);color:#fff}
.bpu{background:var(--pud);color:var(--pu);border:1px solid rgba(192,122,255,.2)}.bpu:hover{background:var(--pu);color:#fff}
.bam{background:var(--amd);color:var(--am);border:1px solid rgba(255,190,64,.2)}.bam:hover{background:var(--am);color:#020c14}
.bsm{padding:4px 10px;font-size:11px}

.pages{flex:1;overflow-y:auto;position:relative}
.pages::-webkit-scrollbar{width:5px}.pages::-webkit-scrollbar-thumb{background:var(--bd2);border-radius:3px}
.pg{display:none;padding:24px}.pg.on{display:block}

/* ─ STATS ─ */
.sr{display:grid;gap:12px;margin-bottom:18px}
.sr-5{grid-template-columns:repeat(5,1fr)}
.sr-4{grid-template-columns:repeat(4,1fr)}
.sr-3{grid-template-columns:repeat(3,1fr)}
.sc{background:var(--surf);border:1px solid var(--bd);border-radius:var(--r);padding:15px;position:relative;overflow:hidden;transition:border-color .18s,transform .14s;cursor:default}
.sc:hover{transform:translateY(-2px);border-color:var(--bd2)}
.sc::before{content:'';position:absolute;top:0;left:0;right:0;height:2px}
.sc.ca::before{background:linear-gradient(90deg,var(--a),var(--bl))}.sc.cb::before{background:var(--bl)}.sc.cam::before{background:var(--am)}.sc.cp::before{background:var(--pu)}.sc.cr::before{background:var(--rd)}.sc.ccy::before{background:var(--cy)}.sc.cgn::before{background:var(--gn)}.sc.cpk::before{background:var(--pk)}
.sl{font-family:'DM Mono',monospace;font-size:8.5px;letter-spacing:1.5px;text-transform:uppercase;color:var(--tx3);margin-bottom:7px}
.sv{font-family:'Orbitron',sans-serif;font-size:24px;font-weight:700;line-height:1;margin-bottom:4px}
.sc.ca .sv{color:var(--a)}.sc.cb .sv{color:var(--bl)}.sc.cam .sv{color:var(--am)}.sc.cp .sv{color:var(--pu)}.sc.cr .sv{color:var(--rd)}.sc.ccy .sv{color:var(--cy)}.sc.cgn .sv{color:var(--gn)}.sc.cpk .sv{color:var(--pk)}
.ss{font-size:10.5px;color:var(--tx3)}
.st{position:absolute;top:12px;right:12px;font-family:'DM Mono',monospace;font-size:9.5px}
.tu{color:var(--a)}.td{color:var(--rd)}.tf{color:var(--tx3)}

/* ─ LAYOUT ─ */
.g2{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:14px}
.g3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:14px;margin-bottom:14px}
.g4{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-bottom:14px}
.g13{display:grid;grid-template-columns:1fr 2fr;gap:14px;margin-bottom:14px}
.g31{display:grid;grid-template-columns:2fr 1fr;gap:14px;margin-bottom:14px}
.g23{display:grid;grid-template-columns:2fr 3fr;gap:14px;margin-bottom:14px}

/* ─ CARD ─ */
.card{background:var(--surf);border:1px solid var(--bd);border-radius:var(--r);overflow:hidden;margin-bottom:14px}
.card:last-child{margin-bottom:0}
.ch{padding:13px 16px 10px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--bd)}
.ct{font-family:'Outfit',sans-serif;font-size:12.5px;font-weight:600;display:flex;align-items:center;gap:7px}
.ca-btn{font-family:'DM Mono',monospace;font-size:9.5px;color:var(--a);cursor:pointer;border:none;background:none;padding:0}
.cb{padding:14px 16px}

/* ─ TABLE ─ */
.tbl{width:100%;border-collapse:collapse}
.tbl th{font-family:'DM Mono',monospace;font-size:8.5px;letter-spacing:1px;text-transform:uppercase;color:var(--tx3);padding:8px 10px;border-bottom:1px solid var(--bd);background:var(--bg3);text-align:left}
.tbl td{padding:8px 10px;font-size:12px;border-bottom:1px solid var(--bd);vertical-align:middle}
.tbl tr:last-child td{border-bottom:none}.tbl tr:hover td{background:var(--bg3)}

/* ─ CHIPS ─ */
.chip{display:inline-flex;align-items:center;gap:3px;padding:2px 8px;border-radius:20px;font-family:'DM Mono',monospace;font-size:8.5px;letter-spacing:.3px;font-weight:500}
.cg{background:var(--ad);color:var(--a)}.cb2{background:var(--bld);color:var(--bl)}.cam2{background:var(--amd);color:var(--am)}.cr2{background:var(--rdd);color:var(--rd)}.cp2{background:var(--pud);color:var(--pu)}.ccy2{background:var(--cyd);color:var(--cy)}.cgn2{background:var(--gnd);color:var(--gn)}.cgr{background:rgba(255,255,255,.05);color:var(--tx3)}.cpk2{background:var(--pkd);color:var(--pk)}

/* ─ FORM ─ */
.fg{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.ff{grid-column:1/-1}
.fgrp{display:flex;flex-direction:column;gap:4px}
.flb{font-family:'DM Mono',monospace;font-size:8.5px;letter-spacing:1px;text-transform:uppercase;color:var(--tx3)}
.fi,.fs,.fta{background:var(--bg3);border:1px solid var(--bd);border-radius:7px;color:var(--tx);font-family:'Outfit',sans-serif;font-size:12.5px;padding:8px 11px;outline:none;width:100%;transition:border-color .13s}
.fi:focus,.fs:focus,.fta:focus{border-color:var(--a);box-shadow:0 0 0 3px var(--ad)}
.fs option{background:var(--bg3)}.fta{resize:vertical;min-height:64px}
.frow{display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px}

/* ─ MODAL ─ */
.ov{position:fixed;inset:0;background:rgba(0,0,0,.8);z-index:900;display:none;align-items:center;justify-content:center;backdrop-filter:blur(7px)}
.ov.on{display:flex}
.modal{background:var(--bg2);border:1px solid var(--bd2);border-radius:13px;width:540px;max-width:96vw;max-height:92vh;overflow-y:auto;animation:su .2s ease}
@keyframes su{from{transform:translateY(14px);opacity:0}to{transform:translateY(0);opacity:1}}
.mh{padding:16px 20px 12px;border-bottom:1px solid var(--bd);display:flex;align-items:center;justify-content:space-between}
.mt{font-family:'Outfit',sans-serif;font-size:14px;font-weight:600}
.mx{width:24px;height:24px;border-radius:6px;background:var(--surf);border:1px solid var(--bd);color:var(--tx2);cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:13px;transition:all .13s}
.mx:hover{color:var(--tx)}
.mb{padding:16px 20px}.mf{padding:11px 20px;border-top:1px solid var(--bd);display:flex;gap:7px;justify-content:flex-end}

/* ─ AI BANNER ─ */
.aib{background:linear-gradient(135deg,rgba(58,159,255,.07),rgba(192,122,255,.05));border:1px solid rgba(58,159,255,.16);border-radius:var(--r);padding:14px 16px;margin-bottom:16px;display:flex;gap:12px;align-items:flex-start}
.aib-ic{font-size:18px;flex-shrink:0}
.aib-t{font-family:'Outfit',sans-serif;font-size:12.5px;font-weight:600;color:var(--bl);margin-bottom:3px}
.aib-x{font-size:12px;color:var(--tx2);line-height:1.55}
.aib-tags{display:flex;gap:5px;margin-top:7px;flex-wrap:wrap}

/* ─ TIMELINE ─ */
.tl{position:relative;padding-left:22px}
.tl::before{content:'';position:absolute;left:6px;top:0;bottom:0;width:1px;background:var(--bd)}
.tli{position:relative;margin-bottom:17px}
.tld{position:absolute;left:-18px;top:3px;width:12px;height:12px;border-radius:50%;border:2px solid var(--bd);background:var(--bg2)}
.tld.dn{background:var(--a);border-color:var(--a);box-shadow:0 0 7px var(--ag)}.tld.ac{background:var(--bl);border-color:var(--bl);animation:pb 2s infinite}.tld.wn{background:var(--am);border-color:var(--am)}
@keyframes pb{0%,100%{box-shadow:0 0 0 0 rgba(58,159,255,.5)}50%{box-shadow:0 0 0 5px rgba(58,159,255,0)}}
.tlt{font-size:12.5px;font-weight:500;margin-bottom:2px}.tlm{font-family:'DM Mono',monospace;font-size:9.5px;color:var(--tx3);margin-bottom:2px}.tld2{font-size:11.5px;color:var(--tx2)}

/* ─ ECG / CHARTS ─ */
.ecg-box{background:#020c06;border:1px solid rgba(0,240,192,.1);border-radius:7px;overflow:hidden;position:relative}
.ecg-lbl{position:absolute;top:6px;left:10px;font-family:'DM Mono',monospace;font-size:8px;color:var(--a);letter-spacing:1px;opacity:.6;z-index:2}
.scan-w{position:relative;overflow:hidden}
.scan-l{position:absolute;left:0;right:0;height:2px;background:linear-gradient(90deg,transparent,var(--a),transparent);animation:scan 2.5s linear infinite;opacity:.35;pointer-events:none;z-index:5}
@keyframes scan{0%{top:0%}100%{top:100%}}

/* ─ VITALS ─ */
.vg{display:grid;grid-template-columns:repeat(4,1fr);gap:9px;margin-bottom:12px}
.vc{background:var(--bg3);border:1px solid var(--bd);border-radius:7px;padding:10px;text-align:center}
.vv{font-family:'DM Mono',monospace;font-size:18px;font-weight:500;margin:3px 0}
.vlb{font-family:'DM Mono',monospace;font-size:8px;letter-spacing:1px;text-transform:uppercase;color:var(--tx3)}
.vu{font-size:9px;color:var(--tx3)}

/* ─ PROGRESS ─ */
.pbg{height:5px;background:var(--bd);border-radius:3px;overflow:hidden}
.pfi{height:100%;border-radius:3px;background:linear-gradient(90deg,var(--a),var(--bl))}
.cb-row{margin-bottom:11px}
.cb-l{display:flex;justify-content:space-between;font-size:11.5px;color:var(--tx2);margin-bottom:4px}
.cb-pct{font-family:'DM Mono',monospace;font-size:9.5px;color:var(--tx3)}

/* ─ PRED BAR ─ */
.pr-row{display:flex;align-items:center;gap:8px;margin-bottom:7px}
.pr-l{font-size:11.5px;flex:1;color:var(--tx2)}
.pr-bg{width:110px;height:6px;border-radius:3px;background:var(--bd);overflow:hidden;flex-shrink:0}
.pr-fi{height:100%;border-radius:3px;transition:width .6s}
.pr-pct{font-family:'DM Mono',monospace;font-size:9.5px;color:var(--tx3);width:32px;text-align:right;flex-shrink:0}

/* ─ ACTIVITY ─ */
.act-i{display:flex;gap:10px;padding:10px 0;border-bottom:1px solid var(--bd);align-items:flex-start}
.act-i:last-child{border-bottom:none}
.act-ic{width:26px;height:26px;border-radius:6px;display:flex;align-items:center;justify-content:center;font-size:11px;flex-shrink:0}
.act-tx{font-size:12px;line-height:1.5}.act-tm{font-family:'DM Mono',monospace;font-size:9.5px;color:var(--tx3);margin-top:2px}

/* ─ GENE GRID ─ */
.gg{display:grid;grid-template-columns:repeat(3,1fr);gap:7px}
.gc{background:var(--bg3);border:1px solid var(--bd);border-radius:7px;padding:9px;transition:border-color .13s}
.gc:hover{border-color:var(--bd2)}
.gn2{font-family:'DM Mono',monospace;font-size:10px;font-weight:500;color:var(--a);margin-bottom:3px}
.gv{font-size:11px;color:var(--tx2)}.gs{font-family:'DM Mono',monospace;font-size:8.5px;margin-top:3px}

/* ─ AI PANEL ─ */
.aip{position:fixed;right:0;top:0;bottom:0;width:380px;background:var(--bg2);border-left:1px solid var(--bd);z-index:300;display:flex;flex-direction:column;transform:translateX(100%);transition:transform .3s cubic-bezier(.4,0,.2,1)}
.aip.on{transform:translateX(0)}
.ai-hdr{padding:15px 17px;border-bottom:1px solid var(--bd);display:flex;align-items:center;gap:10px;flex-shrink:0}
.ai-badge{width:34px;height:34px;background:linear-gradient(135deg,var(--bl),var(--pu));border-radius:9px;display:flex;align-items:center;justify-content:center;font-size:16px;box-shadow:0 0 15px var(--blg);flex-shrink:0}
.ai-title{font-family:'Outfit',sans-serif;font-size:13px;font-weight:600;flex:1}
.ai-sub{font-family:'DM Mono',monospace;font-size:8.5px;color:var(--bl);letter-spacing:.8px}
.ai-msgs{flex:1;overflow-y:auto;padding:12px;display:flex;flex-direction:column;gap:10px}
.ai-msgs::-webkit-scrollbar{width:3px}
.aim{max-width:90%;animation:fu .22s ease}
@keyframes fu{from{opacity:0;transform:translateY(5px)}to{opacity:1;transform:translateY(0)}}
.aim.u{align-self:flex-end}.aim.b{align-self:flex-start}
.aib2{padding:9px 12px;border-radius:11px;font-size:12px;line-height:1.58}
.aim.u .aib2{background:var(--bl);color:#fff;border-bottom-right-radius:2px}
.aim.b .aib2{background:var(--surf2);color:var(--tx);border-bottom-left-radius:2px;border:1px solid var(--bd)}
.aib2 b{color:var(--a)}.aib2 .ail{background:var(--bg3);border:1px solid var(--bd);border-radius:6px;padding:5px 9px;margin-top:5px;font-size:11px}
.ai-typ{display:flex;gap:3px;padding:9px 12px;background:var(--surf2);border:1px solid var(--bd);border-radius:11px;border-bottom-left-radius:2px;align-self:flex-start}
.ai-typ span{width:5px;height:5px;background:var(--tx3);border-radius:50%;animation:bn .9s infinite}
.ai-typ span:nth-child(2){animation-delay:.15s}.ai-typ span:nth-child(3){animation-delay:.3s}
@keyframes bn{0%,60%,100%{transform:translateY(0)}30%{transform:translateY(-5px)}}
.qch-w{padding:7px 13px;display:flex;gap:5px;flex-wrap:wrap;border-top:1px solid var(--bd);flex-shrink:0}
.qch{background:var(--surf2);border:1px solid var(--bd);border-radius:20px;padding:4px 9px;font-size:10.5px;color:var(--tx2);cursor:pointer;transition:all .13s;white-space:nowrap}
.qch:hover{border-color:var(--bl);color:var(--bl);background:var(--bld)}
.ai-inp-r{padding:10px 12px;border-top:1px solid var(--bd);display:flex;gap:7px;flex-shrink:0}
.ai-inp{flex:1;background:var(--bg3);border:1px solid var(--bd);border-radius:7px;color:var(--tx);font-family:'Outfit',sans-serif;font-size:12.5px;padding:7px 11px;outline:none;transition:border-color .13s}
.ai-inp:focus{border-color:var(--bl);box-shadow:0 0 0 3px var(--bld)}
.ai-snd{background:var(--bl);color:#fff;border:none;border-radius:7px;padding:7px 13px;font-size:12.5px;cursor:pointer;font-family:'Outfit',sans-serif;font-weight:500;transition:all .13s}
.ai-snd:hover{filter:brightness(1.14)}
