        <div class="fr fr3"><div class="fg"><label>LL — Liquid Limit (%)</label><input type="number" id="al_LL" value="45"></div><div class="fg"><label>PL — Plastic Limit (%)</label><input type="number" id="al_PL" value="22"></div><div class="fg"><label>w — Natural MC (%)</label><input type="number" id="al_w" value="30"></div></div>
