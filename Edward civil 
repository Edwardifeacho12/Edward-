// ── GEOTECH LAB ──
function calcAtterberg(){
  const LL=v('al_LL'),PL=v('al_PL'),w=v('al_w');
  const PI=LL-PL; const LI=(w-PL)/PI;
  let state=LI<0?'Solid/Semi-solid':LI<1?'Plastic':'Liquid';
  let uscs=PI<7?'ML/CL':LL>50?'MH/CH':'CL/CI';
  sv('al_PI',PI,1); sv('al_LI',LI,2);
  document.getElementById('al_state').textContent=state;
  document.getElementById('al_USCS').textContent=uscs;
  showRes('al_r');
}
function calcProctor(){
  const rb=v('pr_rb'),w=v('pr_w')/100,Gs=v('pr_Gs'),omc=v('pr_omc');
  const rd=rb/(1+w); const e=Gs*9.81/rd-1; const Sr=Gs*w/e*100;
  sv('pr_rd',rd,2); sv('pr_e',e,3); sv('pr_Sr',Sr,1);
  document.getElementById('pr_omc2').textContent=w*100>omc?'Wet of OMC':'Dry of OMC';
  showRes('pr2_r');
}
function calcGrading(){
  const d10=v('gs_d10'),d30=v('gs_d30'),d60=v('gs_d60');
  const Cu=d60/d10; const Cc=d30*d30/(d60*d10);
  let grade='Poorly Graded';
  if(d10<0.075) grade='Fine Grained';
  else if(Cu>4&&Cc>=1&&Cc<=3) grade='Well Graded (GW/SW)';
  else grade='Poorly Graded (GP/SP)';
  sv('gs_Cu',Cu,2); sv('gs_Cc2',Cc,3);
  document.getElementById('gs_grade').textContent=grade;
  showRes('gs_r');
}
function calcPerm(){
  const k=v('pk_k'),i=v('pk_i'),A=v('pk_A'),d10=v('pk_d10');
  const vel=k*i; const q=vel*A; const kh=100*(d10/10)*(d10/10);
  sv('pk_v',vel.toExponential(3)); sv('pk_q',q.toExponential(3)); sv('pk_kh',kh.toFixed(4));
  showRes('pk_r');
}

// ── DRAINAGE ──
function calcCulvert(){
  const Q=v('cv_Q'),H=v('cv_H'),n2=v('cv_n');
  const Cd=0.6; const A_req=Q/(Cd*Math.sqrt(2*9.81*H));
  const D_req=Math.sqrt(4*A_req/Math.PI); const D_adopt=Math.ceil(D_req*10)/10;
  const A_adopt=Math.PI*D_adopt*D_adopt/4;
  const V=Q/A_adopt;
  document.getElementById('cv_d').textContent=D_req.toFixed(3)+' m';
  document.getElementById('cv_da').textContent=D_adopt.toFixed(1)+' m (adopt)';
  sv('cv_V',V,2); showRes('cv_r');
}
function calcGutter(){
  const T=v('kg_T'),Sx=v('kg_Sx'),SL=v('kg_SL')/100,n2=v('kg_n');
  const Q=0.376/n2*Math.pow(Sx,5/3)*Math.pow(SL,0.5)*Math.pow(T,8/3);
  sv('kg_Q',Q,5); sv('kg_Ql',(Q*1000),2); showRes('kg_r');
}
function calcInvert(){
  const ILu=v('il_ILu'),L=v('il_L'),G=v('il_G'),D=v('il_D')/1000;
  const fall=L/G; const ILd=ILu-fall;
  sv('il_ILd',ILd,3); sv('il_fall',fall,3);
  sv('il_su',(ILu+D).toFixed(3)); sv('il_sd',(ILd+D).toFixed(3));
  showRes('il_r');
}

// ── COST ──
function calcConcCost(){
  const vol=v('cc_vol'),grade=parseFloat(document.getElementById('cc_grade').value);
  const rate=v('cc_rate'),rebar=v('cc_rebar'),rebarr=v('cc_rebarr');
  const cc=vol*rate*grade; const rqty=rebar*vol/1000; const rcost=rqty*rebarr;
  sv('cc_c',cc.toFixed(0)); sv('cc_rqty',rqty.toFixed(2)); sv('cc_rcost',rcost.toFixed(0));
  sv('cc_tot',(cc+rcost).toFixed(0)); showRes('cc_r');
}
function calcEarthCost(){
  const Vc=v('ec_Vc'),Vf=v('ec_Vf'),re=v('ec_re'),rf=v('ec_rf'),rh=v('ec_rh'),sf=v('ec_sf');
  const ce=Vc*re; const cf=Vf*rf; const ch=Vc*sf*rh;
  sv('ec_ce',ce.toFixed(0)); sv('ec_cf',cf.toFixed(0)); sv('ec_ch',ch.toFixed(0));
  sv('ec_tot',(ce+cf+ch).toFixed(0)); showRes('ec_r');
}
function calcRoadCost(){
  const L=v('rc_L'),W=v('rc_W'),type=parseInt(document.getElementById('rc_type').value),rate=v('rc_rate');
  const laneKm=L*(W/3.65); const area=L*W*1000;
  const cost=laneKm*rate*type;
  sv('rc_lk',laneKm.toFixed(2)); sv('rc_A',area.toFixed(0)); sv('rc_cost',cost.toFixed(0));
  showRes('rc_r');
}

// ── INTERVIEW PREP ──────────────────────────────────
function ivToggle(el){
  const item=el.closest('.iv-item');
  const wasOpen=item.classList.contains('open');
  // optionally collapse others
  document.querySelectorAll('.iv-item.open').forEach(i=>i.classList.remove('open'));
  if(!wasOpen) item.classList.add('open');
}
let ivCurrentFilter='all';
function ivFilter(cat,el){
  ivCurrentFilter=cat;
  document.querySelectorAll('.iv-filter').forEach(f=>f.classList.remove('on'));
  el.classList.add('on');
  ivApplyFilters();
}
function ivSearch(){
  ivApplyFilters();
}
function ivApplyFilters(){
  const q=(document.getElementById('iv-search').value||'').toLowerCase();
  const cat=ivCurrentFilter;
  let shown=0,total=0;
  document.querySelectorAll('.iv-item').forEach(item=>{
    const itemCat=item.getAttribute('data-cat');
    const qText=(item.getAttribute('data-q')||'').toLowerCase();
    const aText=(item.querySelector('.iv-a')||{}).textContent||'';
    const matchCat=cat==='all'||itemCat===cat;
    const matchQ=!q||qText.includes(q)||aText.toLowerCase().includes(q);
    total++;
    if(matchCat&&matchQ){item.classList.remove('hidden');shown++;}
    else{item.classList.add('hidden');item.classList.remove('open');}
  });
  // Show/hide section headers
  document.querySelectorAll('.iv-section').forEach(sec=>{
    const visItems=sec.querySelectorAll('.iv-item:not(.hidden)');
    sec.style.display=visItems.length?'block':'none';
  });
  document.getElementById('iv-total').textContent=total;
  document.getElementById('iv-showing').textContent=shown;
}
// Init interview stats on page load
document.addEventListener('DOMContentLoaded',function(){
  const total=document.querySelectorAll('.iv-item').length;
  document.getElementById('iv-total').textContent=total;
  document.getElementById('iv-showing').textContent=total;
});
// Also init when navigating to interview page
const _origNav=nav;
function nav(id,el){
  _origNav(id,el);
  if(id==='interview'){
    const total=document.querySelectorAll('.iv-item').length;
    document.getElementById('iv-total').textContent=total;
    document.getElementById('iv-showing').textContent=total;
    document.getElementById('iv-search').value='';
    ivCurrentFilter='all';
    document.querySelectorAll('.iv-filter').forEach(f=>f.classList.remove('on'));
    document.querySelector('.iv-filter').classList.add('on');
    ivApplyFilters();
  }
}
function calcBOD(){
  const L0=v('bod_L0'),D0=v('bod_D0'),kd=v('bod_kd'),kr=v('bod_kr'),t=v('bod_t');
  const D=kd*L0/(kr-kd)*(Math.exp(-kd*t)-Math.exp(-kr*t))+D0*Math.exp(-kr*t);
  const tc=1/(kr-kd)*Math.log(kr/kd*(1-D0*(kr-kd)/(kd*L0)));
  const Dc=kd*L0/(kr-kd)*(Math.exp(-kd*tc)-Math.exp(-kr*tc))+D0*Math.exp(-kr*tc);
  sv('bod_D',D.toFixed(3)); sv('bod_Dc',Dc.toFixed(3));
  document.getElementById('bod_tc').textContent=isFinite(tc)?tc.toFixed(2)+' days':'N/A';
  showRes('bod_r');
}
function calcNoise(){
  const Lw=v('ns_Lw'),r=v('ns_r'),IL=v('ns_IL');
  const Lp=Lw-20*Math.log10(r)-11;
  const Lpb=Lp-IL;
  sv('ns_Lp',Lp,1); sv('ns_Lpb',Lpb,1);
  document.getElementById('ns_comp').textContent=Lpb<=55?'✓ Complies':'✗ Exceeds limit';
  showRes('ns_r2');
}
