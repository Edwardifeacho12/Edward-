  <div class="grid">
    <div class="card">
      <div class="ch"><span class="ci">🛣️</span><span class="ct">STOPPING SIGHT DISTANCE</span></div>
      <div class="cb">
        <div class="fbox"><span class="fx">SSD = V·t/3.6 + V²/(254·(f±G))</span><br>t = PRT = 2.5s &nbsp;|&nbsp; f = friction coeff.</div>
        <div class="fr fr2"><div class="fg"><label>V (km/h)</label><input type="number" id="rd_V" value="80" step="10"></div><div class="fg"><label>Grade G (%)</label><input type="number" id="rd_G" value="0" step="0.5"></div></div>
