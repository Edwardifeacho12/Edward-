        <div class="fr fr2"><div class="fg"><label>A — Area (m²)</label><input type="number" id="pk_A" value="10"></div><div class="fg"><label>D₁₀ (mm) for Hazen</label><input type="number" id="pk_d10" value="0.2" step="0.01"></div></div>
