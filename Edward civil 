    <div class="card">
      <div class="ch"><span class="ci">↓</span><span class="ct">ELASTIC (IMMEDIATE) SETTLEMENT</span></div>
      <div class="cb">
        <div class="fbox"><span class="fx">S_i = q·B·(1-ν²)·I_f / E_s</span><br>I_f ≈ π/4 flexible circle | 1.0 rigid strip</div>
        <div class="fr fr2"><div class="fg"><label>q (kPa)</label><input type="number" id="es_q" value="100"></div><div class="fg"><label>B (m)</label><input type="number" id="es_B" value="1.5"></div></div>
