function show(id){document.getElementById(id).style.display='block';}
function hide(id){document.getElementById(id).style.display='none';}
function v(id){return parseFloat(document.getElementById(id).value)||0;}
function sv(id, val, dec=3){document.getElementById(id).textContent=typeof val==='number'?val.toFixed(dec):val;}
function showRes(id){document.getElementById(id).style.display='block';}

// ── BEAM: SS UDL ──
function calcSSUDL(){
  const w=v('ss1_w'),L=v('ss1_L'),E=v('ss1_E')*1e6,I=v('ss1_I')*1e-8;
  const M=w*L*L/8, V2=w*L/2, d=5*w*L*L*L*L/(384*E*I)*1000;
  sv('ss1_M',M,2); sv('ss1_V',V2,2); sv('ss1_d',d,2); sv('ss1_R',V2,2); showRes('ss1_r');
}
function calcSSPt(){
  const P=v('ssp_P'),a=v('ssp_a'),L=v('ssp_L'),E=v('ssp_E')*1e6,I=v('ssp_I')*1e-8;
  const b=L-a; const Ra=P*b/L, Rb=P*a/L, M=P*a*b/L;
  const d=P*L*L*L/(48*E*I)*1000;
  sv('ssp_M',M,2); sv('ssp_Ra',Ra,2); sv('ssp_Rb',Rb,2); sv('ssp_d',d,2); showRes('ssp_r');
}
// Cantilever UDL
function calcCU(){
  const w=v('cu_w'),L=v('cu_L'),E=v('cu_E')*1e6,I=v('cu_I')*1e-8;
  sv('cu_M',w*L*L/2,2); sv('cu_R',w*L,2); sv('cu_d',w*Math.pow(L,4)/(8*E*I)*1000,2); showRes('cu_r');
}
// Cantilever Point Load
function calcCP(){
  const P=v('cp_P'),L=v('cp_L'),E=v('cp_E')*1e6,I=v('cp_I')*1e-8;
  sv('cp_M',P*L,2); sv('cp_d',P*L*L*L/(3*E*I)*1000,2); showRes('cp_r');
}
// Fixed-Fixed UDL
function calcFF(){
  const w=v('ff_w'),L=v('ff_L'),E=v('ff_E')*1e6,I=v('ff_I')*1e-8;
  sv('ff_Me',w*L*L/12,2); sv('ff_Mm',w*L*L/24,2); sv('ff_d',w*Math.pow(L,4)/(384*E*I)*1000,2); sv('ff_R',w*L/2,2); showRes('ff_r');
}
// Fixed-Fixed Point
function calcFFP(){
  const P=v('ffp_P'),L=v('ffp_L'),E=v('ffp_E')*1e6,I=v('ffp_I')*1e-8;
  sv('ffp_Me',P*L/8,2); sv('ffp_Mm',P*L/8,2); sv('ffp_d',P*L*L*L/(192*E*I)*1000,2); showRes('ffp_r');
}
// Propped Cantilever
function calcPC(){
  const w=v('pc_w'),L=v('pc_L');
  const Rb=3*w*L/8, Ra=5*w*L/8, Ma=w*L*L/8;
  const x=5*L/8; const Mp=Ra*x-w*x*x/2;
  sv('pc_Rb',Rb,2); sv('pc_Ra',Ra,2); sv('pc_Ma',Ma,2); sv('pc_Mp',Mp,2); showRes('pc_r');
}
// Section Properties
function secShape(){
  ['sec_rect','sec_circ','sec_hol','sec_hcirc','sec_Isec'].forEach(id=>hide(id));
  const sh=document.getElementById('sec_sh').value;
  show('sec_'+sh);
}
function calcSec(){
  const sh=document.getElementById('sec_sh').value;
  let A,I,Z,r;
  if(sh==='rect'){const b=v('rb'),h=v('rh'); A=b*h; I=b*h*h*h/12/1e8; Z=I/(h/2/100); r=Math.sqrt(I*1e8/A);}
  else if(sh==='circ'){const d=v('cd'); A=Math.PI*d*d/4; I=Math.PI*Math.pow(d,4)/64/1e8; Z=I/(d/2/100); r=d/4;}
  else if(sh==='hol'){const B=v('hB'),H=v('hH'),b=v('hb'),h=v('hh'); A=B*H-b*h; const Ig=(B*H*H*H-b*h*h*h)/12; I=Ig/1e8; Z=I/(H/2/100); r=Math.sqrt(Ig/A);}
  else if(sh==='hcirc'){const D=v('hcD'),d=v('hcd'); A=Math.PI*(D*D-d*d)/4; const Ig=Math.PI*(Math.pow(D,4)-Math.pow(d,4))/64; I=Ig/1e8; Z=I/(D/2/100); r=Math.sqrt(Ig/A);}
  else{const bf=v('ibf'),tf=v('itf'),hw=v('ihw'),tw=v('itw'); const H=hw+2*tf; A=2*bf*tf+hw*tw; const Ig=(bf*Math.pow(H,3)-(bf-tw)*Math.pow(hw,3))/12; I=Ig/1e8; Z=I/(H/2/100); r=Math.sqrt(Ig/A);}
  sv('sec_A',A,0); sv('sec_I',I,2); sv('sec_Z',Z,2); sv('sec_r2',r,1); showRes('sec_r');
}
// Column
function calcCol(){
  const code=document.getElementById('col_code').value;
  const b=v('col_b'),h=v('col_h'),fc=v('col_fc'),fy=v('col_fy'),rho=v('col_rho')/100,N=v('col_N');
  const Ag=b*h, As=rho*Ag, Ac=Ag-As;
  let Pn;
  if(code==='aci') Pn=0.80*0.65*(0.85*fc*Ac+fy*As)/1000;
  else Pn=(0.4*fc*Ac+0.75*fy*As)/1000;
  const util=N/Pn;
  sv('col_Ag',Ag.toFixed(0)); sv('col_As',As.toFixed(0)); sv('col_Pn',Pn.toFixed(1)); sv('col_u',util.toFixed(2));
  const st=document.getElementById('col_st');
  if(util<=1){st.className='stat ok';st.textContent='✓ ADEQUATE — Capacity '+Pn.toFixed(0)+' kN > '+N+' kN';}
  else{st.className='stat bad';st.textContent='✗ OVERSTRESSED — Increase section or reinforcement';}
  showRes('col_r');
}
function calcSlend(){
  const L=v('sl_L'),k=v('sl_k'),b=v('sl_b'),h=v('sl_h');
  const Le=k*L; const r=Math.min(b,h)/Math.sqrt(12); const lam=Le*1000/r;
  sv('sl_Le',Le,2); sv('sl_r',r,1); sv('sl_lam',lam,1);
  const cls=lam<=12?'SHORT (ACI)':lam<=15?'SHORT (BS)':lam<=22?'SLENDER — needs check':'VERY SLENDER';
  document.getElementById('sl_cls').textContent=cls; showRes('sl_r');
}
function calcLink(){
  const m=v('lk_m'),l=v('lk_l'),b=v('lk_b'),h=v('lk_h');
  const opts=[16*m,48*l,Math.min(b,h)]; const s=Math.min(...opts);
  const gov=opts.indexOf(s)===0?'16φ_main':opts.indexOf(s)===1?'48φ_link':'b/h min';
  sv('lk_s',s,0); document.getElementById('lk_g').textContent=gov; showRes('lk_r');
}
// Slab One-way
function calcOW(){
  const L=v('ow_L'),h=v('ow_h'),dl=v('ow_dl'),ll=v('ow_ll'),fc=v('ow_fc'),fy=v('ow_fy'),cv=v('ow_cv');
  const sw=0.024*h; const wu=1.2*(dl+sw)+1.6*ll; const Mu=wu*L*L/8;
  const d=h-cv-6; const z=0.9*d; const As=Mu*1e6/(0.87*fy*z);
  const Amin=0.13*h*1000/100;
  sv('ow_wu',wu,2); sv('ow_Mu',Mu,2); sv('ow_d',d,0); sv('ow_As',As.toFixed(0)); sv('ow_Amin',Amin.toFixed(0));
  document.getElementById('ow_gov').textContent=As>Amin?'Calc As':'As,min'; showRes('ow_r');
}
// Two-way slab
function calcTW(){
  const lx=v('tw_lx'),ly=v('tw_ly'),wu=v('tw_wu'),edge=parseInt(document.getElementById('tw_edge').value);
  const m=lx/ly;
  const alphaTable={1:[0.062,0.062],2:[0.075,0.047],3:[0.063,0.063],4:[0.075,0.047],5:[0.075,0.047],6:[0.084,0.059],7:[0.080,0.048],8:[0.042,0.030]};
  const [ax,ay]=alphaTable[edge]||[0.062,0.062];
  const Mx=ax*wu*lx*lx, My=ay*wu*lx*lx;
  sv('tw_m',m.toFixed(2)); sv('tw_ax',ax.toFixed(3)); sv('tw_ay',ay.toFixed(3)); sv('tw_Mx',Mx,2); sv('tw_My',My,2); showRes('tw_r');
}
// Punching Shear
function calcPS(){
  const c=v('ps_c'),d=v('ps_d'),V=v('ps_V'),fc=v('ps_fc');
  const u0=4*(c+3*d); const v_check=V*1e3/(u0*d);
  const vRdc=0.12*(100*0.005*fc)**(1/3)*1.0;
  sv('ps_u',u0.toFixed(0)); sv('ps_v',v_check.toFixed(3)); sv('ps_vr',vRdc.toFixed(3));
  document.getElementById('ps_st').textContent=v_check<=vRdc?'✓ OK':'✗ SHEAR REINF. NEEDED'; showRes('ps_r');
}
// Truss
function calcTruss(){
  const span=v('tr_sp'),rise=v('tr_ri'),w=v('tr_w'),np=v('tr_np');
  const rl=Math.sqrt(rise*rise+Math.pow(span/2,2));
  const pitch=rise/(span/2);
  const TL=w*rl*2; const R=TL/2;
  const theta=Math.atan(rise/(span/2));
  const TC=R/Math.sin(theta); const BC=R/Math.tan(theta);
  sv('tr_pit',(pitch).toFixed(3)+'  ('+Math.atan(pitch)*180/Math.PI.toFixed(1)+'°)');
  document.getElementById('tr_pit').textContent=pitch.toFixed(3);
  sv('tr_rl',rl,3); sv('tr_TL',TL,2); sv('tr_R',R,2);
  sv('tr_TC',TC.toFixed(2)+' (C)'); sv('tr_BC',BC.toFixed(2)+' (T)'); showRes('tr_r');
}
// Frame
function calcPortal(){
  const L=v('pf_L'),h=v('pf_h'),w=v('pf_w');
  const Rv=w*L/2; const H=w*L*L/(8*h); const Mk=H*h; const Mb=w*L*L/8-Mk;
  sv('pf_Rv',Rv,2); sv('pf_H',H,2); sv('pf_Mk',Mk,2); sv('pf_Mb',Mb,2); showRes('pf_r');
}
// Foundation
function calcPad(){
  const P=v('pd_P'),q=v('pd_q'),D=v('pd_D'),gs=v('pd_gs'),h=v('pd_h');
  const Wf=0.024*h/1000; const Ws=gs*D;
  const Ptotal=P+(Wf+Ws)*0;
  const Areq=P/q; const sz=Math.sqrt(Areq); const Ades=Math.ceil(sz*10)/10;
