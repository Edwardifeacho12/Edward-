<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Edward Civil — Engineering Suite</title>
<link href="https://fonts.googleapis.com/css2?family=Rajdhani:wght@400;500;600;700&family=Share+Tech+Mono&family=Exo+2:wght@300;400;600;700;900&display=swap" rel="stylesheet">
<style>
:root {
  --bg0:#090a0c; --bg1:#0e1014; --bg2:#141720; --bg3:#1a1e2a;
  --bg4:#202535; --bg5:#262c3f;
  --amber:#f59e0b; --amber2:#fbbf24; --amber3:#fde68a;
  --steel:#4a5568; --steel2:#718096; --steel3:#a0aec0;
  --red:#f56565; --green:#48bb78; --blue:#63b3ed; --cyan:#76e4f7; --purple:#b794f4;
  --text:#e2e8f0; --text2:#a0aec0; --text3:#718096; --text4:#4a5568;
  --border:#1e2433; --border2:#252d40;
  --font-head:'Exo 2',sans-serif; --font-body:'Rajdhani',sans-serif; --font-mono:'Share Tech Mono',monospace;
  --radius:6px; --glow:0 0 20px rgba(245,158,11,0.15);
}
*{box-sizing:border-box;margin:0;padding:0;}
html,body{height:100%;font-family:var(--font-body);background:var(--bg0);color:var(--text);overflow-x:hidden;}

/* ── BLUEPRINT GRID ── */
body::before{
  content:'';position:fixed;inset:0;pointer-events:none;z-index:0;
  background-image:
    linear-gradient(rgba(99,179,237,0.025) 1px,transparent 1px),
    linear-gradient(90deg,rgba(99,179,237,0.025) 1px,transparent 1px);
  background-size:60px 60px;
}
body::after{
  content:'';position:fixed;inset:0;pointer-events:none;z-index:0;
  background:radial-gradient(ellipse at 20% 50%,rgba(245,158,11,0.04) 0%,transparent 60%),
             radial-gradient(ellipse at 80% 20%,rgba(99,179,237,0.03) 0%,transparent 50%);
}

/* ── HEADER ── */
#header{
  position:fixed;top:0;left:0;right:0;height:56px;z-index:1000;
  background:rgba(9,10,12,0.96);backdrop-filter:blur(16px);
  border-bottom:1px solid var(--border2);
  display:flex;align-items:center;justify-content:space-between;padding:0 20px;
}
.logo{display:flex;align-items:center;gap:10px;}
.logo-mark{
  width:36px;height:36px;background:var(--amber);border-radius:4px;
  display:flex;align-items:center;justify-content:center;
  font-family:var(--font-head);font-weight:900;font-size:14px;color:#000;letter-spacing:-1px;
  box-shadow:0 0 16px rgba(245,158,11,0.4);
}
.logo-name{font-family:var(--font-head);font-weight:700;font-size:18px;letter-spacing:3px;color:var(--text);}
.logo-name span{color:var(--amber);}
.header-right{display:flex;align-items:center;gap:12px;}
.h-badge{
  font-family:var(--font-mono);font-size:9px;letter-spacing:3px;color:var(--amber);
  background:rgba(245,158,11,0.08);border:1px solid rgba(245,158,11,0.25);
  padding:3px 10px;border-radius:3px;
}
.h-status{display:flex;align-items:center;gap:5px;font-family:var(--font-mono);font-size:10px;color:var(--green);}
.dot{width:6px;height:6px;background:var(--green);border-radius:50%;animation:pulse 2s infinite;}
@keyframes pulse{0%,100%{opacity:1;}50%{opacity:.3;}}

/* ── LAYOUT ── */
#app{display:flex;height:100vh;padding-top:56px;position:relative;z-index:1;}

/* ── SIDEBAR ── */
#sidebar{
  width:230px;flex-shrink:0;
  background:var(--bg1);border-right:1px solid var(--border2);
  overflow-y:auto;padding:12px 0;
  position:sticky;top:56px;height:calc(100vh - 56px);
}
#sidebar::-webkit-scrollbar{width:3px;}
#sidebar::-webkit-scrollbar-thumb{background:var(--border2);}
.sb-cat{font-family:var(--font-mono);font-size:9px;letter-spacing:3px;color:var(--text4);text-transform:uppercase;padding:14px 16px 5px;}
.sb-item{
  display:flex;align-items:center;gap:10px;padding:9px 16px;
  cursor:pointer;font-size:13px;font-weight:600;color:var(--text2);
  border-left:2px solid transparent;transition:all .15s;letter-spacing:.5px;
}
.sb-item:hover{background:var(--bg2);color:var(--text);border-left-color:var(--border2);}
.sb-item.on{background:rgba(245,158,11,0.07);color:var(--amber);border-left-color:var(--amber);}
.sb-icon{font-size:14px;width:18px;text-align:center;flex-shrink:0;}

/* ── MAIN ── */
#main{flex:1;overflow-y:auto;padding:24px;background:transparent;}
#main::-webkit-scrollbar{width:4px;}
#main::-webkit-scrollbar-thumb{background:var(--border2);}

/* ── PAGE ── */
.page{display:none;animation:fadein .2s ease;}
.page.on{display:block;}
@keyframes fadein{from{opacity:0;transform:translateY(8px);}to{opacity:1;transform:none;}}

/* ── PAGE HEADER ── */
.ph{display:flex;align-items:flex-end;justify-content:space-between;margin-bottom:22px;padding-bottom:14px;border-bottom:1px solid var(--border2);}
.ph h1{font-family:var(--font-head);font-weight:900;font-size:26px;letter-spacing:2px;line-height:1;}
.ph h1 em{color:var(--amber);font-style:normal;}
.ph-sub{font-family:var(--font-mono);font-size:9px;color:var(--text4);letter-spacing:3px;margin-top:3px;}

/* ── GRID / CARDS ── */
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(320px,1fr));gap:14px;}
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:14px;}
.card{
  background:var(--bg2);border:1px solid var(--border2);border-radius:var(--radius);
  overflow:hidden;transition:border-color .2s;
}
.card:hover{border-color:var(--steel);}
.ch{
  display:flex;align-items:center;gap:10px;padding:12px 14px;
  border-bottom:1px solid var(--border);background:var(--bg3);
}
.ci{font-size:16px;}
.ct{font-family:var(--font-head);font-weight:700;font-size:12px;letter-spacing:2px;color:var(--text);}
.cb{padding:14px;}

/* ── FORMULA BOX ── */
.fbox{
  background:var(--bg4);border:1px solid var(--border2);border-radius:4px;
  padding:9px 12px;font-family:var(--font-mono);font-size:10px;color:var(--steel3);
  margin-bottom:11px;line-height:1.9;
}
.fbox .fx{color:var(--amber2);font-size:11px;}

/* ── FORM ── */
.fr{display:grid;gap:8px;margin-bottom:8px;}
.fr1{grid-template-columns:1fr;}
.fr2{grid-template-columns:1fr 1fr;}
.fr3{grid-template-columns:1fr 1fr 1fr;}
.fg{display:flex;flex-direction:column;gap:3px;}
.fg label{font-family:var(--font-mono);font-size:9px;color:var(--text3);letter-spacing:2px;text-transform:uppercase;}
.fg input,.fg select{
  background:var(--bg1);border:1px solid var(--border2);border-radius:4px;
  padding:7px 9px;color:var(--text);font-family:var(--font-mono);font-size:12px;
  outline:none;transition:border-color .15s;width:100%;
}
.fg input:focus,.fg select:focus{border-color:var(--amber);}
.fg select option{background:var(--bg1);}

/* ── BUTTONS ── */
.btn{
  padding:8px 16px;border-radius:4px;cursor:pointer;border:none;
  font-family:var(--font-head);font-weight:700;font-size:12px;letter-spacing:2px;
  transition:all .15s;display:inline-flex;align-items:center;gap:6px;
}
.btn-a{background:var(--amber);color:#000;}
.btn-a:hover{background:var(--amber2);box-shadow:var(--glow);}
.btn-o{background:transparent;border:1px solid var(--border2);color:var(--text2);}
.btn-o:hover{border-color:var(--amber);color:var(--amber);}

/* ── RESULT BOX ── */
.rbox{
  background:var(--bg1);border:1px solid var(--border2);border-radius:4px;
  padding:12px;margin-top:11px;font-family:var(--font-mono);
}
.rbox.ok{border-color:rgba(72,187,120,.35);background:rgba(72,187,120,.04);}
.rbox.warn{border-color:rgba(245,158,11,.35);background:rgba(245,158,11,.04);}
.rbox.bad{border-color:rgba(245,101,101,.35);background:rgba(245,101,101,.04);}
.rl{font-size:9px;letter-spacing:2px;color:var(--text3);text-transform:uppercase;}
.rv{font-size:15px;color:var(--amber2);font-weight:700;margin-top:2px;}
.rgrid{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:6px;}
.rgrid3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px;margin-top:6px;}
.ri{}

/* ── STATUS ── */
.stat{
  display:flex;align-items:center;gap:6px;padding:6px 10px;
  border-radius:3px;font-family:var(--font-mono);font-size:10px;margin-top:8px;
}
.stat.ok{background:rgba(72,187,120,.1);border:1px solid rgba(72,187,120,.3);color:var(--green);}
.stat.warn{background:rgba(245,158,11,.1);border:1px solid rgba(245,158,11,.3);color:var(--amber);}
.stat.bad{background:rgba(245,101,101,.1);border:1px solid rgba(245,101,101,.3);color:var(--red);}

/* ── TABS ── */
.tabs{display:flex;border-bottom:1px solid var(--border2);margin-bottom:16px;flex-wrap:wrap;}
.tab{
  padding:8px 16px;cursor:pointer;font-family:var(--font-head);font-weight:600;
  font-size:12px;letter-spacing:1px;color:var(--text3);border-bottom:2px solid transparent;transition:all .15s;
}
.tab:hover{color:var(--text);}
.tab.on{color:var(--amber);border-bottom-color:var(--amber);}
.tpanel{display:none;}
.tpanel.on{display:block;}

/* ── TABLE ── */
.tbl{width:100%;border-collapse:collapse;font-size:11px;font-family:var(--font-mono);}
.tbl th{background:var(--bg4);color:var(--text3);font-size:9px;letter-spacing:2px;padding:7px 10px;border:1px solid var(--border);text-align:left;}
.tbl td{padding:7px 10px;border:1px solid var(--border);color:var(--text2);}
.tbl tr:hover td{background:rgba(245,158,11,.03);color:var(--text);}
.ok{color:var(--green);} .warn2{color:var(--amber);} .bad2{color:var(--red);}

/* ── DIVIDER ── */
.div{border:none;border-top:1px solid var(--border);margin:12px 0;}

/* ── DASH CARDS ── */
.dg{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:10px;margin-bottom:22px;}
.dc{
  background:var(--bg2);border:1px solid var(--border2);border-radius:var(--radius);
  padding:14px;cursor:pointer;transition:all .2s;
}
.dc:hover{border-color:var(--amber);background:var(--bg3);transform:translateY(-2px);}
.dc-i{font-size:24px;margin-bottom:6px;}
.dc-t{font-family:var(--font-head);font-weight:700;font-size:12px;letter-spacing:1px;color:var(--text);}
.dc-s{font-family:var(--font-mono);font-size:9px;color:var(--text3);margin-top:2px;line-height:1.5;}

/* ── PROGRESS ── */
.prog{background:var(--bg1);border-radius:3px;height:5px;overflow:hidden;margin-top:4px;}
.progf{height:100%;border-radius:3px;transition:width .4s;}
.pg{background:var(--green);} .pw{background:var(--amber);} .pb{background:var(--red);}

/* ── BIG NUMBER ── */
.bignum{
  background:linear-gradient(135deg,var(--bg3),var(--bg4));
  border:1px solid var(--border2);border-radius:var(--radius);
  padding:16px;text-align:center;margin-top:12px;
}
.bn-l{font-family:var(--font-mono);font-size:9px;color:var(--text3);letter-spacing:3px;}
.bn-v{font-family:var(--font-head);font-weight:900;font-size:32px;color:var(--amber);line-height:1;}
.bn-u{font-family:var(--font-mono);font-size:11px;color:var(--steel2);margin-top:2px;}

/* ── DIAGRAM ── */
.diag{background:var(--bg3);border:1px solid var(--border2);border-radius:4px;padding:10px;margin-bottom:10px;display:flex;align-items:center;justify-content:center;min-height:70px;}
.beam-svg{width:100%;height:60px;}

/* ── UNIT CONV ── */
.uc-row{display:flex;align-items:center;gap:8px;margin-bottom:8px;}
.uc-eq{font-family:var(--font-mono);font-size:18px;color:var(--text3);}

/* ── WARN LABEL ── */
.wl{font-family:var(--font-mono);font-size:9px;color:var(--amber);letter-spacing:1px;margin-top:4px;}
.anno{font-family:var(--font-mono);font-size:9px;color:var(--text4);margin-top:5px;font-style:italic;}

/* ── SCROLLBAR everywhere ── */
::-webkit-scrollbar{width:4px;height:4px;}
::-webkit-scrollbar-track{background:var(--bg0);}
::-webkit-scrollbar-thumb{background:var(--border2);border-radius:2px;}

/* ── INTERVIEW ACCORDION ── */
.iv-search{
  width:100%;background:var(--bg1);border:1px solid var(--border2);border-radius:6px;
  padding:10px 14px;color:var(--text);font-family:var(--font-mono);font-size:13px;
  outline:none;margin-bottom:18px;transition:border-color .15s;
}
.iv-search:focus{border-color:var(--amber);}
.iv-search::placeholder{color:var(--text4);}
.iv-filters{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:18px;}
.iv-filter{
  padding:5px 14px;border-radius:20px;cursor:pointer;
  font-family:var(--font-mono);font-size:10px;letter-spacing:1px;
  border:1px solid var(--border2);color:var(--text3);background:var(--bg2);
  transition:all .15s;
}
.iv-filter:hover{border-color:var(--amber);color:var(--amber);}
.iv-filter.on{background:var(--amber);color:#000;border-color:var(--amber);}
.iv-section{margin-bottom:20px;}
.iv-sec-title{
  font-family:var(--font-head);font-weight:700;font-size:11px;letter-spacing:3px;
  color:var(--text4);text-transform:uppercase;margin-bottom:8px;padding-bottom:6px;
  border-bottom:1px solid var(--border);
}
.iv-item{
  background:var(--bg2);border:1px solid var(--border2);border-radius:6px;
  margin-bottom:6px;overflow:hidden;transition:border-color .15s;
}
.iv-item:hover{border-color:var(--steel);}
.iv-item.hidden{display:none;}
.iv-q{
  display:flex;align-items:center;justify-content:space-between;
  padding:12px 16px;cursor:pointer;gap:12px;
}
.iv-q-text{
  font-family:var(--font-body);font-weight:600;font-size:13px;color:var(--text);
  letter-spacing:.3px;flex:1;
}
.iv-arrow{color:var(--text4);font-size:10px;transition:transform .2s;flex-shrink:0;}
.iv-item.open .iv-arrow{transform:rotate(180deg);color:var(--amber);}
.iv-item.open .iv-q{background:var(--bg3);}
.iv-item.open .iv-q-text{color:var(--amber2);}
.iv-a{
  display:none;padding:14px 16px;border-top:1px solid var(--border);
  background:var(--bg1);font-family:var(--font-body);font-size:13px;
  color:var(--text2);line-height:1.7;
}
.iv-item.open .iv-a{display:block;}
.iv-a strong,.iv-a .kw{color:var(--amber2);}
.iv-a .formula{
  background:var(--bg4);border:1px solid var(--border2);border-radius:4px;
  padding:6px 10px;font-family:var(--font-mono);font-size:11px;color:var(--steel3);
  margin:6px 0;display:block;
}
.iv-tag{
  display:inline-block;padding:2px 8px;border-radius:3px;font-family:var(--font-mono);
  font-size:9px;letter-spacing:1px;margin-left:8px;
  background:rgba(245,158,11,0.1);border:1px solid rgba(245,158,11,0.25);color:var(--amber);
}
.iv-tag.inter{background:rgba(99,179,237,0.1);border-color:rgba(99,179,237,0.25);color:var(--blue);}
.iv-tag.adv{background:rgba(245,101,101,0.1);border-color:rgba(245,101,101,0.25);color:var(--red);}
.iv-stats{display:flex;gap:16px;margin-bottom:16px;font-family:var(--font-mono);font-size:10px;color:var(--text3);}
.iv-stats span{color:var(--amber);}

</style>
</head>
