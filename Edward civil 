        <div class="fr fr2"><div class="fg"><label>L_w — Sound Power (dB)</label><input type="number" id="ns_Lw" value="105"></div><div class="fg"><label>r — Distance (m)</label><input type="number" id="ns_r" value="50"></div></div>
