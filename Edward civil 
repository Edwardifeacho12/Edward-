        <div id="pk_r" class="rbox" style="display:none">
          <div class="rgrid">
            <div class="ri"><div class="rl">v (m/s)</div><div class="rv" id="pk_v"></div></div>
            <div class="ri"><div class="rl">q (m³/s)</div><div class="rv" id="pk_q"></div></div>
            <div class="ri"><div class="rl">k (Hazen, cm/s)</div><div class="rv" id="pk_kh"></div></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

