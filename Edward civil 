<div class="page" id="pg-drain">
  <div class="ph"><div><h1>Drainage <em>Design</em></h1><div class="ph-sub">CULVERT · GUTTER · STORM DRAIN · INVERT LEVELS</div></div></div>
  <div class="grid">
    <div class="card">
      <div class="ch"><span class="ci">🏞️</span><span class="ct">CULVERT SIZING (INLET CONTROL)</span></div>
      <div class="cb">
        <div class="fbox"><span class="fx">Q = C_d · A · √(2g·H)</span> (submerged outlet)<br>Box: <span class="fx">Q = 1.0·B·D·√(2g·H_w)</span> &nbsp;|&nbsp; Pipe: <span class="fx">Q = C·A·(2g·H)^0.5</span></div>
        <div class="fr fr2"><div class="fg"><label>Type</label><select id="cv_type"><option value="pipe">Circular Pipe</option><option value="box">Box Culvert</option></select></div><div class="fg"><label>Design Flow Q (m³/s)</label><input type="number" id="cv_Q" value="1.5" step="0.1"></div></div>
        <div class="fr fr2"><div class="fg"><label>H_w — Headwater (m)</label><input type="number" id="cv_H" value="1.2" step="0.1"></div><div class="fg"><label>Manning n</label><input type="number" id="cv_n" value="0.013" step="0.001"></div></div>
        <button class="btn btn-a" onclick="calcCulvert()">▶ SIZE CULVERT</button>
        <div id="cv_r" class="rbox" style="display:none">
          <div class="rgrid">
            <div class="ri"><div class="rl">Req. Diameter/Width</div><div class="rv" id="cv_d"></div></div>
            <div class="ri"><div class="rl">Adopted Size</div><div class="rv" id="cv_da"></div></div>
            <div class="ri"><div class="rl">Velocity (m/s)</div><div class="rv" id="cv_V"></div></div>
          </div>
        </div>
      </div>
    </div>
    <div class="card">
      <div class="ch"><span class="ci">🏞️</span><span class="ct">KERB GUTTER FLOW</span></div>
      <div class="cb">
        <div class="fbox"><span class="fx">Q = (K/n)·S_x^(5/3)·S_L^(1/2)·T^(8/3)</span><br>K=0.376, T=spread width, S_x=cross-slope, S_L=longitudinal slope</div>
        <div class="fr fr2"><div class="fg"><label>T — Spread Width (m)</label><input type="number" id="kg_T" value="2.0" step="0.1"></div><div class="fg"><label>S_x — Cross Slope (m/m)</label><input type="number" id="kg_Sx" value="0.02" step="0.005"></div></div>
        <div class="fr fr2"><div class="fg"><label>S_L — Long. Slope (%)</label><input type="number" id="kg_SL" value="1.0" step="0.1"></div><div class="fg"><label>n — Manning</label><input type="number" id="kg_n" value="0.016" step="0.001"></div></div>
        <button class="btn btn-a" onclick="calcGutter()">▶ CALCULATE</button>
        <div id="kg_r" class="rbox" style="display:none">
          <div class="rgrid">
            <div class="ri"><div class="rl">Q (m³/s)</div><div class="rv" id="kg_Q"></div></div>
            <div class="ri"><div class="rl">Q (L/s)</div><div class="rv" id="kg_Ql"></div></div>
          </div>
        </div>
      </div>
    </div>
    <div class="card">
      <div class="ch"><span class="ci">🏞️</span><span class="ct">INVERT LEVEL &amp; SOFFIT CALCULATION</span></div>
      <div class="cb">
        <div class="fbox"><span class="fx">IL_out = IL_in − (S × L)</span><br><span class="fx">Soffit = IL + D</span> (pipe diameter) &nbsp;|&nbsp; Min cover = 0.9m (road), 0.6m (other)</div>
        <div class="fr fr2"><div class="fg"><label>IL Upstream (m AOD)</label><input type="number" id="il_ILu" value="100.0" step="0.01"></div><div class="fg"><label>Pipe Length (m)</label><input type="number" id="il_L" value="50"></div></div>
        <div class="fr fr2"><div class="fg"><label>Gradient (1 in X)</label><input type="number" id="il_G" value="100"></div><div class="fg"><label>Pipe Diameter (mm)</label><input type="number" id="il_D" value="300"></div></div>
        <button class="btn btn-a" onclick="calcInvert()">▶ CALCULATE</button>
        <div id="il_r" class="rbox" style="display:none">
          <div class="rgrid">
            <div class="ri"><div class="rl">IL Downstream</div><div class="rv" id="il_ILd"></div></div>
            <div class="ri"><div class="rl">Fall (m)</div><div class="rv" id="il_fall"></div></div>
            <div class="ri"><div class="rl">Soffit upstream</div><div class="rv" id="il_su"></div></div>
            <div class="ri"><div class="rl">Soffit downstream</div><div class="rv" id="il_sd"></div></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

