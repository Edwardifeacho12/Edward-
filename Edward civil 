    </div>
    <div class="card">
      <div class="ch"><span class="ci">↓</span><span class="ct">PRIMARY CONSOLIDATION</span></div>
      <div class="cb">
        <div class="fbox"><span class="fx">S_c = C_c·H/(1+e₀)·log₁₀[(σ'₀+Δσ)/σ'₀]</span> NC clay<br><span class="fx">S_c = C_s·H/(1+e₀)·log₁₀[(σ'₀+Δσ)/σ'₀]</span> OC (σ' ≤ σ'_p)</div>
        <div class="fr fr2"><div class="fg"><label>C_c</label><input type="number" id="sc_Cc" value="0.35" step="0.01"></div><div class="fg"><label>e₀</label><input type="number" id="sc_e0" value="0.8" step="0.05"></div></div>
        <div class="fr fr3"><div class="fg"><label>H (m)</label><input type="number" id="sc_H" value="5"></div><div class="fg"><label>σ'₀ (kPa)</label><input type="number" id="sc_s0" value="80"></div><div class="fg"><label>Δσ (kPa)</label><input type="number" id="sc_ds" value="60"></div></div>
