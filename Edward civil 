<div class="page" id="pg-seismic">
  <div class="ph"><div><h1>Seismic <em>Analysis</em></h1><div class="ph-sub">EQUIVALENT STATIC · BASE SHEAR · RESPONSE SPECTRUM</div></div></div>
  <div class="grid">
    <div class="card">
      <div class="ch"><span class="ci">🌊</span><span class="ct">EQUIVALENT STATIC FORCE (UBC/IBC)</span></div>
      <div class="cb">
        <div class="fbox"><span class="fx">V = C_s · W</span> &nbsp;|&nbsp; <span class="fx">C_s = S_DS / (R/I_e)</span><br><span class="fx">S_DS = (2/3)·F_a·S_s</span> &nbsp;|&nbsp; T = C_t · h_n^x</div>
        <div class="fr fr2"><div class="fg"><label>S_DS — Design Spectral Accel.</label><input type="number" id="eq_Sds" value="0.9" step="0.05"></div><div class="fg"><label>R — Response Factor</label><select id="eq_R"><option value="8">8 — Special RC Frame</option><option value="6" selected>6 — Intermediate Frame</option><option value="4">4 — Ordinary Frame</option><option value="3">3 — Shear Wall</option></select></div></div>
        <div class="fr fr2"><div class="fg"><label>I_e — Importance Factor</label><select id="eq_Ie"><option value="1.0" selected>1.0 — Normal</option><option value="1.25">1.25 — Essential</option><option value="1.5">1.5 — Critical</option></select></div><div class="fg"><label>W — Seismic Weight (kN)</label><input type="number" id="eq_W" value="5000"></div></div>
        <div class="fr fr2"><div class="fg"><label>h_n — Building Height (m)</label><input type="number" id="eq_h" value="20"></div><div class="fg"><label>Structure Type</label><select id="eq_type"><option value="rc">RC Frame (Ct=0.073)</option><option value="steel">Steel Frame (Ct=0.085)</option><option value="sw">Shear Wall (Ct=0.05)</option></select></div></div>
        <button class="btn btn-a" onclick="calcSeismic()">▶ CALCULATE</button>
        <div id="eq_r" class="rbox" style="display:none">
          <div class="rgrid">
            <div class="ri"><div class="rl">Period T (s)</div><div class="rv" id="eq_T"></div></div>
            <div class="ri"><div class="rl">C_s (seismic coeff)</div><div class="rv" id="eq_Cs"></div></div>
            <div class="ri"><div class="rl">Base Shear V (kN)</div><div class="rv" id="eq_V"></div></div>
            <div class="ri"><div class="rl">V/W ratio</div><div class="rv" id="eq_ratio"></div></div>
          </div>
        </div>
      </div>
    </div>
    <div class="card">
      <div class="ch"><span class="ci">🌊</span><span class="ct">VERTICAL DISTRIBUTION OF SEISMIC FORCES</span></div>
      <div class="cb">
        <div class="fbox"><span class="fx">F_x = C_vx · V</span> &nbsp;|&nbsp; <span class="fx">C_vx = w_x·h_x^k / Σ(w_i·h_i^k)</span><br>k=1 for T≤0.5s, k=2 for T≥2.5s, interpolate between</div>
