// ─ ECG CANVAS ─
const ecgCanvases = {};
const ecgRAFs = {};
function stopECG(canvasId){ if(ecgRAFs[canvasId]){ cancelAnimationFrame(ecgRAFs[canvasId]); delete ecgRAFs[canvasId]; } }
function drawECG(canvasId, color='#00f0c0', noisy=false){
  const canvas = document.getElementById(canvasId);
  if(!canvas) return;
  stopECG(canvasId);
  const ctx = canvas.getContext('2d');
  canvas.width = canvas.offsetWidth||canvas.clientWidth||400;
  canvas.height = canvas.offsetHeight||canvas.clientHeight||80;
  if(!ecgCanvases[canvasId]) ecgCanvases[canvasId] = {offset:0};
  const W = canvas.width, H = canvas.height;
  const data = ecgCanvases[canvasId];
  const sp = noisy ? 1.5 : 2.5;
  function frame(){
    ctx.clearRect(0,0,W,H);
    ctx.fillStyle = '#020c06'; ctx.fillRect(0,0,W,H);
    // Grid
    ctx.strokeStyle='rgba(0,240,192,.05)'; ctx.lineWidth=1;
    for(let x=0;x<W;x+=20){ctx.beginPath();ctx.moveTo(x,0);ctx.lineTo(x,H);ctx.stroke();}
    for(let y=0;y<H;y+=20){ctx.beginPath();ctx.moveTo(0,y);ctx.lineTo(W,y);ctx.stroke();}
    // ECG Waveform
    ctx.strokeStyle=color; ctx.lineWidth=1.5; ctx.shadowColor=color; ctx.shadowBlur=4;
    ctx.beginPath();
    for(let x=0;x<W;x++){
      const t=(x+data.offset)/sp;
      const phase = t%100;
      let y;
      if(phase<5) y=0;
      else if(phase<7) y=-8*(phase-5)/2; // P wave up
      else if(phase<9) y=-8+(8*(phase-7)/2);
      else if(phase<13) y=0;
      else if(phase<14) y=-3*(phase-13); // Q down
      else if(phase<16) y=-3+38*(phase-14)/2; // R up
      else if(phase<18) y=35-35*(phase-16)/2; // R down
      else if(phase<20) y=-6*(phase-18)/2; // S down
      else if(phase<22) y=-6+6*(phase-20)/2; // S up
      else if(phase<30) y=0;
      else if(phase<38) y=-12*Math.sin(Math.PI*(phase-30)/8); // T wave
      else y=0;
      if(noisy) y+=((Math.random()-0.5)*3);
      const py = H/2 - y*(H/60);
      if(x===0) ctx.moveTo(x,py); else ctx.lineTo(x,py);
    }
    ctx.stroke(); ctx.shadowBlur=0;
    data.offset += sp;
    ecgRAFs[canvasId] = requestAnimationFrame(frame);
  }
  ecgRAFs[canvasId] = requestAnimationFrame(frame);
}

function drawEEG(canvasId, color='#3a9fff'){
  const canvas = document.getElementById(canvasId);
  if(!canvas) return;
  stopECG(canvasId);
  const ctx = canvas.getContext('2d');
  canvas.width = canvas.offsetWidth||400;
  canvas.height = canvas.offsetHeight||110;
  if(!ecgCanvases[canvasId]) ecgCanvases[canvasId] = {offset:0};
  const data = ecgCanvases[canvasId];
  const W=canvas.width, H=canvas.height;
  function frame(){
    ctx.clearRect(0,0,W,H);
    ctx.fillStyle='#030a0e'; ctx.fillRect(0,0,W,H);
    ctx.strokeStyle=color; ctx.lineWidth=1.2; ctx.shadowColor=color; ctx.shadowBlur=3;
    ctx.beginPath();
    for(let x=0;x<W;x++){
      const t=(x+data.offset)*0.08;
      const y = 12*Math.sin(t*10)+6*Math.sin(t*22+1.2)+3*Math.sin(t*5.5)+2*Math.cos(t*30)+((Math.random()-0.5)*2);
      const py = H/2-y*(H/80);
      x===0?ctx.moveTo(x,py):ctx.lineTo(x,py);
    }
    ctx.stroke(); ctx.shadowBlur=0;
    data.offset+=2;
    ecgRAFs[canvasId] = requestAnimationFrame(frame);
  }
  ecgRAFs[canvasId] = requestAnimationFrame(frame);
}

function initCanvases(){
 
  // Canvases may have offsetWidth=0 if parent not yet painted
  const ecgIds = ['ecg1','ecg2','ecg-cardio'];
  const eegIds = ['eeg1','eeg-neuro'];
  function tryDraw(attempt){
    let allReady = true;
    ecgIds.forEach(id=>{
      const el = document.getElementById(id);
      if(el){
        if(el.offsetWidth > 0){ drawECG(id,'#00f0c0'); }
        else { allReady = false; el.style.minWidth='100%'; }
      }
    });
    eegIds.forEach(id=>{
      const el = document.getElementById(id);
      if(el){
        if(el.offsetWidth > 0){ drawEEG(id,'#3a9fff'); }
        else { allReady = false; }
      }
    });
   
    if(!allReady && attempt < 5) setTimeout(()=>tryDraw(attempt+1), 150*attempt);
  }
  setTimeout(()=>tryDraw(1), 120);
}

