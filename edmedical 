  const epEl   = document.getElementById('status-endpoint');
  const ltEl   = document.getElementById('status-last-test');
  if(circle){ circle.style.background=connected?'var(--ad)':'var(--rdd)'; circle.style.borderColor=connected?'var(--a)':'var(--rd)'; circle.textContent=connected?'✓':'✕'; }
  if(label){ label.textContent=connected?'CONNECTED':'NOT CONNECTED'; label.style.color=connected?'var(--a)':'var(--rd)'; }
  if(modeEl) modeEl.textContent = connected?(mode==='direct'?'🔑 Direct API Key':'🛡 Proxy / Worker'):'—';
  if(epEl)   epEl.textContent   = connected?endpoint:'—';
  if(ltEl)   ltEl.textContent   = connected?new Date().toLocaleTimeString():'—';

  // Mode status text
  const ms = document.getElementById('mode-status');
  if(ms){ ms.textContent=connected?'● CONNECTED':'○ NOT CONFIGURED'; ms.style.color=connected?'var(--a)':'var(--tx3)'; }
}

function initSettingsPage(){
  // Restore saved values into the settings form
  if(AI_KEY && document.getElementById('api-key-input'))
    document.getElementById('api-key-input').value = AI_KEY;
  if(AI_PROXY && document.getElementById('proxy-url-input'))
    document.getElementById('proxy-url-input').value = AI_PROXY;
  selectMode(AI_MODE);

  // Update status indicators based on whether we have credentials
  const hasKey = (AI_MODE==='direct' && AI_KEY) || (AI_MODE==='proxy' && AI_PROXY);
  if(hasKey) updateAIStatus(true, AI_MODE, AI_MODE==='proxy'?AI_PROXY:'api.anthropic.com');
  else updateAIStatus(false);
}

// ─ CLAUDE API ─
// ╔══════════════════════════════════════════════════════╗
// ║  API KEY CONFIGURATION                               ║
// ║  Option A — Direct (dev/private): paste key below    ║
// ║  Option B — Proxy (production):   set PROXY_URL      ║
// ╚══════════════════════════════════════════════════════╝
const EDMED_API_KEY  = '';           
const EDMED_PROXY_URL = '';          

async function callClaudeAI(userMessage, systemPrompt=null, history=[]){
  // Runtime override: settings page values take priority over hardcoded constants
  const key   = AI_KEY   || EDMED_API_KEY;
  const proxy = AI_PROXY || EDMED_PROXY_URL;
  const mode  = proxy ? 'proxy' : (key ? 'direct' : AI_MODE);
  return callClaudeAIRaw(userMessage, systemPrompt, history, mode, key, proxy);
}

async function callClaudeAIRaw(userMessage, systemPrompt=null, history=[], mode, key, proxy){
  if(!key && !proxy) throw new Error('No API key configured. Add your key in Settings → AI Settings, or paste it into EDMED_API_KEY in the source.');

  const messages = [...history];
  if(!history.length || history[history.length-1]?.role!=='user'){
    messages.push({role:'user', content:userMessage});
  }
  const body = { model:'claude-sonnet-4-5-20251001', max_tokens:1000, messages };
  if(systemPrompt) body.system = systemPrompt;

  let url, headers;
  if(proxy){
    url = proxy;
    headers = { 'Content-Type':'application/json' };
  } else {
    url = 'https://api.anthropic.com/v1/messages';
    headers = {
      'Content-Type':'application/json',
      'x-api-key': key,
      'anthropic-version':'2023-06-01',
      'anthropic-dangerous-direct-browser-access':'true'
    };
  }

  const response = await fetch(url, { method:'POST', headers, body:JSON.stringify(body) });
  if(!response.ok){
    const err = await response.json().catch(()=>({}));
    throw new Error(err.error?.message || ('HTTP ' + response.status));
  }
  const data = await response.json();
  return data.content.map(c=>c.text||'').join('');
}

