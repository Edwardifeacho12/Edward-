function askAI(msg){
  if(!document.getElementById('ai-panel').classList.contains('on')) openAI();
  // Check configuration before sending
  const notConfigured = !(AI_KEY||AI_PROXY||EDMED_API_KEY||EDMED_PROXY_URL);
  if(notConfigured){
    appendAIMsg(msg,'u');
    appendAIMsg('⚙ AI is not configured yet.\n\nGo to **Settings** (⚙ button above or sidebar) to add your API key or proxy URL. It only takes 2 minutes!','b');
    return;
  }
  appendAIMsg(msg,'u');
  const typing=appendTyping();
  const sysPrompt = `You are Edmed AI, an advanced medical research assistant built into the Edmed Medical Research OS. You have full context on the CARDIO-7 Phase III trial (NCT04829182): 84/120 enrolled participants with HFrEF (LVEF ≤40%), Day 147, double-blind RCT with Compound X vs placebo. Key current data: BNP 380 pg/mL (P-0077), LVEF 32%, K⁺ 5.8 mEq/L (elevated), 3 active AEs (no SAEs), AI study success probability 87%, predicted completion Aug 2025. PI: Dr. Ifeacho Edward, First Bank Nigeria account 3113044716. You are a helpful, precise, medically accurate assistant. Format responses with markdown-style bold for key terms. Keep responses focused and clinical. Max 200 words.`;
  aiHistory.push({role:'user',content:msg});
  callClaudeAI(msg, sysPrompt, aiHistory.slice(-8)).then(r=>{
    typing.remove();
    aiHistory.push({role:'assistant',content:r});
    appendAIMsg(r,'b');
  }).catch(err=>{
    typing.remove();
    appendAIMsg(`⚠ AI connection error. Please check your network. Error: ${err.message||err}`,'b');
  });
}

function appendAIMsg(msg, role){
