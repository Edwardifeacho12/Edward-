async function saveAISettings(){
  const resEl = document.getElementById('conn-result');
  resEl.innerHTML = '<div style="font-family:DM Mono,monospace;font-size:10px;color:var(--bl)">⏳ Connecting…</div>';

  const mode = AI_MODE;
  const key  = document.getElementById('api-key-input')?.value.trim()||'';
  const proxy= document.getElementById('proxy-url-input')?.value.trim()||'';

  if(mode==='direct' && !key){
    resEl.innerHTML='<div style="color:var(--rd);font-size:11px">⚠ Please enter your API key</div>'; return;
  }
  if(mode==='proxy' && !proxy){
    resEl.innerHTML='<div style="color:var(--rd);font-size:11px">⚠ Please enter your Worker URL</div>'; return;
  }

  // Test the connection with a minimal message
  try {
    const testResult = await callClaudeAIRaw('Reply with exactly: CONNECTION OK', null, [], mode, key, proxy);
    // Save to localStorage only after successful test
    localStorage.setItem('edmed_ai_mode', mode);
    localStorage.setItem('edmed_api_key', key);
    localStorage.setItem('edmed_proxy_url', proxy);
    AI_MODE = mode; AI_KEY = key; AI_PROXY = proxy;
    const preview = testResult.substring(0,50);
    resEl.innerHTML = '<div style="background:var(--ad);border:1px solid rgba(0,240,192,.2);border-radius:7px;padding:10px;color:var(--a);font-family:DM Mono,monospace;font-size:10px">✓ CONNECTED — ' + preview + '</div>';
    updateAIStatus(true, mode, mode==='proxy'?proxy:'api.anthropic.com');
    toast('AI connected successfully!','✦');
  } catch(err) {
    const errMsg = err.message;
    const hint = mode==='direct'?'API key':'Worker URL';
    resEl.innerHTML = '<div style="background:var(--rdd);border:1px solid rgba(255,77,77,.2);border-radius:7px;padding:10px;color:var(--rd);font-size:11px">✕ Connection failed: ' + errMsg + '<br><span style="font-size:10px;color:var(--tx3)">Check your ' + hint + ' and try again</span></div>';
    updateAIStatus(false);
  }
}

